{
  "name": "speaktype-desktop",
  "productName": "SpeakType",
  "version": "0.20.1",
  "private": true,
  "description": "Hold a hotkey to speak, release to drop text at the cursor of any Windows app",
  "author": "SpeakType",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "electron-vite build && electron-builder --win --x64",
    "sums": "node scripts/release-sums.mjs",
    "pack:portable": "electron-vite build && electron-builder --win portable --x64",
    "pack:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "pack:mac": "electron-vite build && electron-builder --mac --config electron-builder-mac.yml",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "koffi": "2.14.1",
    "lucide-react": "^0.560.0",
    "pinyin-pro": "^3.29.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "sherpa-onnx-node": "^1.13.7",
    "uiohook-napi": "1.5.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "opencc-js": "^1.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^5.0.0"
  }
}
